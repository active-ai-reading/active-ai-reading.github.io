{%- comment -%}
  Bottom of a post. For a post on a paper: every other post the class wrote on that paper,
  then the newest posts on other papers. For a post with no paper: the newest other posts.
  How many from other papers: related_blog_posts.max_related in _config.yml.
{%- endcomment -%}
{%- assign _max = site.related_blog_posts.max_related | default: 5 -%}
{%- if page.paper -%}
  {%- assign _paper = site.papers | where: 'slug', page.paper | first -%}
  {%- assign _same = site.posts | where: 'paper', page.paper | where_exp: 'p', 'p.url != page.url' -%}
  {%- assign _others = site.posts | where_exp: 'p', 'p.paper != page.paper' -%}
{%- else -%}
  {%- assign _same = '' | split: '' -%}
  {%- assign _others = site.posts | where_exp: 'p', 'p.url != page.url' -%}
{%- endif -%}

{% if _same.size > 0 %}
  <section class="related-posts">
    <h2 class="section-title">
      More on {{ _paper.short | default: _paper.title | default: 'this paper' }} <span class="count">{{ _same.size }}</span>
    </h2>
    <div class="post-grid">
      {% for p in _same %}{% include course/post_card.liquid post=p %}{% endfor %}
    </div>
    {% if _paper %}<p><a href="{{ _paper.url | relative_url }}">The paper's page, with every post by role →</a></p>{% endif %}
  </section>
{% endif %}

{% if _others.size > 0 %}
  <section class="related-posts">
    <h2 class="section-title">{% if page.paper %}On other papers{% else %}More from the class{% endif %}</h2>
    <div class="post-grid">
      {% for p in _others limit: _max %}{% include course/post_card.liquid post=p show_paper=true %}{% endfor %}
    </div>
    <p><a href="{{ '/posts/' | relative_url }}">All posts →</a></p>
  </section>
{% endif %}

{% if site.newsletter.enabled and site.footer_fixed %}
  <p class="mb-2" style="margin-top: 1.5rem !important">Subscribe to be notified of future articles:</p>
  {% include newsletter.liquid left=true %}
{% endif %}
