{%- comment -%}
  Paper cards, latest week first, so the upcoming paper is near the top and a `limit` keeps the
  newest ones. Papers not on the schedule come last, newest first. Each scheduled card shows its
  week and date; the script below marks the upcoming meeting and the one after it, the same way
  the schedule page does (the first meeting today or later).
  Usage: {% include course/paper_grid.liquid limit=6 %}
{%- endcomment -%}
{%- assign _shown = '' -%}
{%- assign _count = 0 -%}
{%- assign _limit = include.limit | default: 1000 -%}
{%- assign _weeks = site.data.schedule | reverse -%}
<div class="paper-grid">
  {%- for w in _weeks -%}
    {%- assign _p = site.papers | where: 'slug', w.paper | first -%}
    {%- capture _key %}|{{ w.paper }}|{% endcapture -%}
    {%- if _p and _count < _limit -%}
      {%- unless _shown contains _key -%}
        {%- capture _ts %}{% include course/class_date.liquid week=w.week %}{% endcapture -%}
        {% include course/paper_card.liquid paper=_p week=w.week date=_ts %}
        {%- assign _shown = _shown | append: _key -%}
        {%- assign _count = _count | plus: 1 -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign _rest = site.papers | sort: 'year' | reverse -%}
  {%- for _p in _rest -%}
    {%- capture _key %}|{{ _p.slug }}|{% endcapture -%}
    {%- if _count < _limit -%}
      {%- unless _shown contains _key -%}
        {% include course/paper_card.liquid paper=_p %}
        {%- assign _count = _count | plus: 1 -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
</div>
<script>
  // Mark the upcoming meeting and the one after it. The upcoming meeting is the first one today
  // or later, among all scheduled weeks (not only those with a paper), like the schedule page.
  (function () {
    var now = new Date();
    var today = now.getFullYear() + "-" + String(now.getMonth() + 1).padStart(2, "0") + "-" + String(now.getDate()).padStart(2, "0");
    var dates = [{% for w in site.data.schedule %}{% capture _ts %}{% include course/class_date.liquid week=w.week %}{% endcapture %}"{{ _ts | date: '%Y-%m-%d' }}"{% unless forloop.last %},{% endunless %}{% endfor %}];
    var upcoming = null, after = null;
    for (var i = 0; i < dates.length; i++) {
      if (dates[i] >= today) { upcoming = dates[i]; after = dates[i + 1] || null; break; }
    }
    document.querySelectorAll(".paper-card[data-date]").forEach(function (card) {
      var d = card.dataset.date, label = d === upcoming ? "Upcoming meeting" : d === after ? "After that" : null;
      if (!label) return;
      var week = card.querySelector(".paper-card-week");
      if (week) week.insertAdjacentHTML("afterbegin", '<span class="now-badge">' + label + "</span> ");
    });
  })();
</script>
