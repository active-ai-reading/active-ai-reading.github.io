{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <!--
    Avoid warning on Google Chrome Error with Permissions-Policy header:
    Origin trial controlled feature not enabled: 'interest-cohort'.
    see https://stackoverflow.com/a/75119417
  -->
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>
  {% if site.title == 'blank' %}
    {% capture title %}{{ author_name }}{% endcapture %}
  {% else %}
    {% capture title %}{{ site.title }}{% endcapture %}
  {% endif %}
  {% if page.url == '/posts/index.html' %}
    {{ page.title }} | {{ title }}
  {% elsif page.title != 'blank' and page.url != '/' %}
    {% if page.title == null or page.title == '' %}
      {{ page.date | date: '%Y' }} | {{ title }}
    {% else %}
      {{ page.title }} | {{ title }}
    {% endif %}
  {% else %}
    {{ title }}
  {% endif %}
</title>
{%- comment -%}
  ---------------------------------------------------------------------------
  Course SEO and social previews (Discord, Slack, X, Bluesky, LinkedIn...).
  Description: the page's `description`, else a paper's `tldr`, a guide's role
  summary or a profile's `tagline`, else the site description.
  Image: the page's `og_image`, else a card generated at build time by
  bin/og/make_cards.py (posts and papers), else the site default.
  ---------------------------------------------------------------------------
{%- endcomment -%}
{%- assign seo_base = site.url | append: site.baseurl -%}
{%- assign seo_url = page.url | prepend: seo_base | remove_first: 'index.html' -%}
{%- assign seo_title = page.title -%}
{%- if page.url == '/' or seo_title == nil or seo_title == '' -%}{%- assign seo_title = site.title -%}{%- endif -%}
{%- assign seo_desc = page.description -%}
{%- if seo_desc == nil or seo_desc == '' -%}
  {%- if page.collection == 'papers' -%}{%- assign seo_desc = page.tldr -%}
  {%- elsif page.collection == 'guides' -%}{%- assign _r = site.data.roles | where: 'id', page.role | first -%}{%- assign seo_desc = _r.summary -%}
  {%- elsif page.collection == 'people' -%}{%- assign seo_desc = page.tagline -%}
  {%- endif -%}
{%- endif -%}
{%- if seo_desc == nil or seo_desc == '' -%}{%- assign seo_desc = site.description -%}{%- endif -%}
{%- assign seo_desc = seo_desc | strip_html | strip_newlines | strip | truncate: 200 -%}
{%- assign seo_image = page.og_image -%}
{%- if seo_image == nil or seo_image == '' -%}
  {%- if page.collection == 'posts' -%}{%- capture _card %}/assets/og/{{ page.slug }}.png{% endcapture -%}
  {%- elsif page.collection == 'papers' -%}{%- capture _card %}/assets/og/paper-{{ page.slug }}.png{% endcapture -%}
  {%- else -%}{%- assign _card = nil -%}{%- endif -%}
  {%- if _card -%}{%- assign _found = site.static_files | where: 'path', _card | first -%}{%- if _found -%}{%- assign seo_image = _card -%}{%- endif -%}{%- endif -%}
{%- endif -%}
{%- if seo_image == nil or seo_image == '' -%}{%- assign seo_image = site.og_image -%}{%- endif -%}
{%- unless seo_image contains '://' -%}{%- assign seo_image = seo_image | prepend: seo_base -%}{%- endunless -%}
{%- assign seo_authors = '' | split: '' -%}
{%- for h in page.by -%}{%- assign _p = site.people | where: 'slug', h | first -%}{%- assign _n = _p.name | default: h -%}{%- assign seo_authors = seo_authors | push: _n -%}{%- endfor -%}
{%- assign seo_paper = site.papers | where: 'slug', page.paper | first -%}

<meta name="description" content="{{ seo_desc | escape }}">
{% if seo_authors.size > 0 %}<meta name="author" content="{{ seo_authors | join: ', ' | escape }}">{% endif %}
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}
{% if page.collection == 'showcase' %}<meta name="robots" content="noindex">{% endif %}
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ '/feed.xml' | relative_url }}">

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{% if page.collection == 'posts' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ seo_title | escape }}">
  <meta property="og:url" content="{{ seo_url }}">
  <meta property="og:description" content="{{ seo_desc | escape }}">
  <meta property="og:image" content="{{ seo_image }}">
  <meta property="og:image:alt" content="{{ seo_title | escape }}">
  <meta property="og:locale" content="en_US">
  {% if page.collection == 'posts' %}
    <meta property="article:published_time" content="{{ page.date | date_to_xmlschema }}">
    {% for a in seo_authors %}<meta property="article:author" content="{{ a | escape }}">{% endfor %}
  {% endif %}

  <!-- Twitter / X, also used by Bluesky and Discord -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo_title | escape }}">
  <meta name="twitter:description" content="{{ seo_desc | escape }}">
  <meta name="twitter:image" content="{{ seo_image }}">
  <meta name="theme-color" content="#c2410c">
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org: tells search and AI engines what this page is, who wrote it, and which paper it is about -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      {% if page.collection == 'posts' %}
      "@type": "BlogPosting",
      "headline": {{ seo_title | jsonify }},
      "datePublished": "{{ page.date | date_to_xmlschema }}",
      "author": [{% for a in seo_authors %}{"@type": "Person", "name": {{ a | jsonify }}}{% unless forloop.last %}, {% endunless %}{% endfor %}],
      {% if seo_paper %}
      "about": {
        "@type": "ScholarlyArticle",
        "name": {{ seo_paper.title | jsonify }},
        "author": {{ seo_paper.authors | jsonify }}{% if seo_paper.arxiv %},
        "url": "https://arxiv.org/abs/{{ seo_paper.arxiv }}"{% endif %}
      },
      {% endif %}
      {% elsif page.collection == 'papers' %}
      "@type": "WebPage",
      "name": {{ seo_title | jsonify }},
      "about": {
        "@type": "ScholarlyArticle",
        "name": {{ page.title | jsonify }},
        "author": {{ page.authors | jsonify }}{% if page.arxiv %},
        "url": "https://arxiv.org/abs/{{ page.arxiv }}"{% endif %}
      },
      {% elsif page.url == '/' %}
      "@type": "WebSite",
      "name": {{ site.title | jsonify }},
      {% else %}
      "@type": "WebPage",
      "name": {{ seo_title | jsonify }},
      {% endif %}
      "description": {{ seo_desc | jsonify }},
      "url": "{{ seo_url }}",
      "image": "{{ seo_image }}",
      "publisher": {
        "@type": "Organization",
        "name": {{ site.title | jsonify }},
        "url": "{{ seo_base }}/",
        "sameAs": ["https://github.com/{{ site.github_repo }}"]
      }
    }
  </script>
{% endif %}
